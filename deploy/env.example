# Copia este archivo a deploy/.env en el servidor y llena los valores.
# Genera los secretos con:  openssl rand -hex 24   (y para AUTH_SECRET: openssl rand -base64 32)

# --- Base de datos (solo letras y números en la contraseña) ---
POSTGRES_USER="spark"
POSTGRES_PASSWORD="CAMBIAR"
POSTGRES_DB="thesparkindex"

# --- Dominio ---
# Antes de tener dominio: ":80" y SITE_URL con la IP (http://157.137.188.96)
# Con dominio: "revista.ejemplo.com" y SITE_URL="https://revista.ejemplo.com"
# Varios dominios a la vez (separados por coma): "a.ejemplo.com, b.ejemplo.com"
#   (SITE_URL debe ser el dominio principal: se usa en el sitemap y en los enlaces)
SITE_ADDRESS=":80"
SITE_URL="http://157.137.188.96"
SITE_NAME="KEY — The Spark Index"

# --- Auth.js ---
AUTH_SECRET="CAMBIAR"
AUTH_TRUST_HOST="true"

# --- API de contenido (/api/v1, la usa el MCP para publicar artículos) ---
# Vacío = API desactivada. Para activarla:  openssl rand -hex 32
CONTENT_API_TOKEN=""

# --- MCP remoto (conector de claude.ai): https://<sitio>/api/mcp/<MCP_URL_SECRET> ---
# Vacío = desactivado. Para activarlo:  openssl rand -hex 24
MCP_URL_SECRET=""

# --- Archivos subidos (volumen Docker) ---
STORAGE_DRIVER="local"
STORAGE_DIR="storage/uploads"

# --- Seed ---
ADMIN_EMAIL="admin@keyinstitute.edu.sv"
ADMIN_PASSWORD="CAMBIAR"
# false = solo secciones, admin y configuración; true = también artículos de demostración
SEED_DEMO="false"
